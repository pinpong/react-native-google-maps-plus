<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <!--
    Empty on purpose: the library sends no data off the device. It hands the
    location to the host app, which declares what it does with it.
  -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>

  <!--
    Empty on purpose: the library uses no required reason api. The Google Maps
    SDK ships its own manifest.
  -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array/>

</dict>
</plist>
