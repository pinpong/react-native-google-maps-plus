{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.tsx"],
  "entryPointStrategy": "resolve",
  "readme": "none",
  "tsconfig": "./tsconfig.json",
  "out": "docs",
  "cleanOutputDir": true,
  "includeVersion": true,
  "categorizeByGroup": true,
  "sort": [
    "kind",
    "static-first",
    "instance-first",
    "visibility",
    "alphabetical"
  ],
  "kindSortOrder": ["Variable", "Interface", "Module"],
  "navigationLinks": {
    "GitHub": "https://github.com/pinpong/react-native-google-maps-plus"
  },
  "sidebarLinks": {
    "Installation": "https://pinpong.github.io/react-native-google-maps-plus/#installation",
    "Upgrading from 1.x": "https://pinpong.github.io/react-native-google-maps-plus/#upgrading-from-1x",
    "Location": "https://pinpong.github.io/react-native-google-maps-plus/#location",
    "SVG markers": "https://pinpong.github.io/react-native-google-maps-plus/#svg-markers",
    "Advanced markers": "https://pinpong.github.io/react-native-google-maps-plus/#advanced-markers",
    "Troubleshooting": "https://pinpong.github.io/react-native-google-maps-plus/#troubleshooting",
    "Limitations": "https://pinpong.github.io/react-native-google-maps-plus/#limitations"
  },
  "visibilityFilters": {
    "inherited": true,
    "external": true,
    "protected": true,
    "private": true
  },
  "externalSymbolLinkMappings": {
    "react-native-nitro-modules": {
      "HybridObject": "#",
      "other": "#"
    }
  },
  "highlightLanguages": [
    "ts",
    "tsx",
    "js",
    "json",
    "bash",
    "ruby",
    "swift",
    "xml",
    "groovy"
  ]
}
